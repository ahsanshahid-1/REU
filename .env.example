# Copy to .env for local runs (never commit .env). Hosts set these in their dashboard.
PORT=3000
NODE_ENV=production
ADMIN_TOKEN=replace-with-a-long-random-string
# DEV_ECHO_CODES=1   # ONLY for local testing: echoes email verification codes. Never in production.

# ---- Transactional email (verification codes + submission confirmations) ----
# The Email_Service builds a nodemailer SMTP transport from these values. When
# SMTP_HOST is set, real mail is sent (UALR SMTP relay, Amazon SES, SendGrid,
# etc.). When SMTP_HOST is unset the app runs without a transport: set
# DEV_ECHO_CODES=1 for local testing (codes surfaced, no mail sent), otherwise
# a required send fails (fail-safe) so production never silently "succeeds"
# without email. Credentials come only from the environment, never hard-coded.
# SMTP_HOST=smtp.example.edu           # SMTP server hostname
# SMTP_PORT=587                        # 587 (STARTTLS) or 465 (implicit TLS)
# SMTP_SECURE=false                    # true for port 465, false for 587/25
# SMTP_USER=reu-mailer                 # SMTP auth username (omit if relay is open/IP-authed)
# SMTP_PASS=replace-with-smtp-password # SMTP auth password
# MAIL_FROM="UA Little Rock REU <reu@ualr.edu>"  # From: header on outgoing mail

# ---- Chatbot (RAG assistant) ----
# Hugging Face access token for the LLM (Inference Providers, OpenAI-compatible
# router at https://router.huggingface.co/v1/chat/completions). Create one at
# https://huggingface.co/settings/tokens (a free "Read" token works; the free
# tier includes monthly inference credits). If unset, the assistant runs in
# retrieval-only mode: it returns the best matching snippet from the site.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# Model served via Inference Providers. Override to switch models without code
# changes. Default: meta-llama/Llama-3.1-8B-Instruct
# CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- Participant showcase (Requirement 19, post-award phase) ----
# The public Showcase_Section (/showcase.html + GET /api/showcase) is OFF by
# default. Set SHOWCASE_ENABLED=1 only after a cohort exists. Even when enabled,
# the showcase stays "forthcoming" until curated cohort data is present, so it
# is never enabled while empty. Cohort data lives in a SEPARATE curated file,
# data/showcase.json (an array of { "institution": "...", "year": "..." }
# records), NOT the applications intake table — so internal-review fields
# (statement, references, contact, transcript) are structurally excluded from
# the public projection, which shows home institution and academic year only.
# SHOWCASE_ENABLED=1

# ---- Abuse / rate-limit hardening (bot & DDoS defense in depth) ----
# App-level rate limiting on the sensitive write endpoints (account
# register/verify/login/resend and application submission). This is a SECOND
# layer behind the edge WAF/reverse-proxy that fronts the CRC deployment — not
# a substitute for it (see DEPLOY.md "Abuse protection").
#
# Enabled by default in production (NODE_ENV=production). Set RATE_LIMIT_ENABLED
# explicitly to force it on (=1) or off (=0). All caps below are optional and
# have sensible defaults.
# RATE_LIMIT_ENABLED=1
# AUTH_RATE_MAX=30              # max auth-cluster requests per IP per window
# AUTH_RATE_EMAIL_MAX=6         # max auth-cluster requests per target email per window
# AUTH_RATE_WINDOW_MS=900000    # auth window in ms (default 15 min)
# APPLY_RATE_MAX=8              # max application submissions per user/IP per window
# APPLY_RATE_WINDOW_MS=3600000  # apply window in ms (default 1 hour)
#
# When running behind the CRC reverse proxy, set TRUST_PROXY so req.ip reflects
# the real client (correct rate-limit keying). Use `true`, a hop count, or a
# trusted subnet. Leave unset for a direct/dev deployment.
# TRUST_PROXY=true
